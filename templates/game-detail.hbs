{{#if game.background_image}}
<img class="game-detail__cover" src="{{rawgImage game.background_image 600}}" alt="{{game.name}}">
{{/if}}

<div class="game-detail__header">
  <h1 class="game-detail__title">{{game.name}}</h1>

  {{#if user}}
  {{#if favorited}}
  <form action="/favorites/remove" method="POST">
    <input type="hidden" name="game_id" value="{{game.id}}">
    <button type="submit" class="favorite-button">Remove from Favorites</button>
  </form>
  {{else}}
  <form action="/favorites/add" method="POST">
    <input type="hidden" name="game_id" value="{{game.id}}">
    <input type="hidden" name="game_slug" value="{{game.slug}}">
    <input type="hidden" name="game_name" value="{{game.name}}">
    <input type="hidden" name="game_background_image" value="{{game.background_image}}">
    <input type="hidden" name="game_rating" value="{{game.rating}}">
    <input type="hidden" name="game_released" value="{{game.released}}">
    <input type="hidden" name="game_playtime" value="{{game.playtime}}">
    <button type="submit" class="favorite-button">Add to Favorites</button>
  </form>
  {{/if}}
  {{else}}
    <a href="/auth/discord/login">Login to add to Favorites</a>
  {{/if}}
</div>

<div class="game-detail__meta">
  <span>⭐ {{game.rating}} / 5</span>
  <span>Released: {{game.released}}</span>
  <span>Playtime: {{game.playtime}}h</span>
</div>

{{#if game.genres}}
<div class="game-detail__genres">
  <strong>Genres:</strong>
  {{#each game.genres}}
  <span class="tag">{{this.name}}</span>
  {{/each}}
</div>
{{/if}}

{{#if game.platforms}}
<div class="game-detail__platforms">
  <strong>Platforms:</strong>
  {{#each game.platforms}}
  <span class="tag">{{this.platform.name}}</span>
  {{/each}}
</div>
{{/if}}

{{#if game.description_raw}}
<div class="game-detail__description">
  <h2>About</h2>
  <p>{{game.description_raw}}</p>
</div>
{{/if}}
