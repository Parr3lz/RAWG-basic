{
  "name": "rawg",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:client": "esbuild client/legacy/app.ts --bundle --outfile=public/app.js --target=es2022",
    "build:react": "npm run typecheck:react && mkdir -p public/react && cp client/react/index.html public/react/index.html && esbuild client/react/main.tsx --bundle --outfile=public/react/app.js --target=es2022 --tsconfig=client/react/tsconfig.json",
    "build": "npm run typecheck:client && npm run build:client && npm run build:react && tsc",
    "start": "node --env-file=.env.local dist/server.js",
    "dev": "npm run build:client -- --watch & tsx watch --env-file=.env.local server.ts",
    "dev:react": "npm run build:react -- --watch --servedir=public --serve=127.0.0.1:3001",
    "typecheck:client": "tsc --project tsconfig.client.json",
    "typecheck:react": "tsc --project client/react/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  }
}
